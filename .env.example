# Supabase Configuration
# URL de l'instance Supabase (accessible côté client et serveur)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Clé publique Supabase (Anon Key) - soumise aux politiques Row Level Security (RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key

# Clé secrète d'administration Supabase (Service Role Key)
# ATTENTION : Ne JAMAIS exposer côté client ! Utilisée uniquement dans les Server Actions / API sécurisées
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_key

# Configuration de l'application
NEXT_PUBLIC_SITE_NAME="Habses history and families"
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Configuration des notifications par email (Optionnel - Resend)
# Si non renseigné, les emails sont enregistrés et simulés dans les logs d'audit sans erreur
RESEND_API_KEY=re_example_apiKey
EMAIL_FROM="Habses Mémoire & Familles <notifications@habses.org>"
ADMIN_CONTACT_EMAIL=ruben.yldz@gmail.com
