# Supabase Configuration
# URL de l'instance Supabase (accessible côté client et serveur)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Clé publique Supabase (Anon Key) - soumise aux politiques Row Level Security (RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key

# Clé secrète d'administration Supabase (Service Role Key)
# ATTENTION : Ne JAMAIS exposer côté client ! Utilisée uniquement dans les Server Actions / API sécurisées
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_key

# Configuration de l'application
NEXT_PUBLIC_SITE_NAME="Mémoire et Généalogie d'Hapses"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
